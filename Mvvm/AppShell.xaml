<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mvvm.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Mvvm.Views"
    xmlns:local="clr-namespace:Mvvm"
    Title="Mvvm">

    <Shell.FlyoutHeader>
        <StackLayout
            BackgroundColor="DarkGreen"
            Padding="20"
            VerticalOptions="Center">
            <Label FontAttributes="Bold" FontSize="Header" Text="Welcome" />
        </StackLayout>
    </Shell.FlyoutHeader>
    <Shell.FlyoutFooter>
        <StackLayout
                BackgroundColor="Red" 
                Padding="20" 
                VerticalOptions="Center">
            <Label FontAttributes="Bold" FontSize="Subtitle" Text="menu"/>
        </StackLayout>
    </Shell.FlyoutFooter>
    <FlyoutItem Title="More" Icon="splash.png">

    <ShellContent
        Title="Home"
            ContentTemplate="{DataTemplate views:UserList}"
            Route="MainPage" />
    </FlyoutItem>




</Shell>
