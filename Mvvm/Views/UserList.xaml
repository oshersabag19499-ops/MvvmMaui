<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mvvm.Views.UserList"
             xmlns:views="clr-namespace:Mvvm.Views"
             xmlns:models="clr-namespace:Mvvm.Models"
             xmlns:vm="clr-namespace:Mvvm.ViewModels"
             x:DataType="vm:UserListvm"
             Title="UserList">
    <VerticalStackLayout>
        
        <Label 
            Text="User List"
            FontSize="Medium" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Picker  Title="choose person"
            ItemsSource="{Binding Users}"
                 ItemDisplayBinding="{Binding Name}"
                 SelectedItem="{Binding User}">
        </Picker>

        <Label 
        Text="{Binding DisplayUser}"
        VerticalOptions="Center" 
        HorizontalOptions="Center" />

        <CollectionView ItemsSource ="{Binding Users}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="Peru" 
                                 Command="{Binding x:DataType='vm:UserListvm',Source={RelativeSource AncestorType={x:Type vm:UserListvm}},Path=DeleteUserCommand}"
                                 CommandParameter="{Binding .}"/>
                            </SwipeItems>

                        </SwipeView.RightItems>
                        <Border BackgroundColor= "FloralWhite" StrokeThickness="1">
                            <Grid ColumnDefinitions="*,*,*">
                                <Label Text="{Binding Name}" TextColor="DarkOrchid" FontSize="Medium"/>
                                <Label Grid.Column="1" Text="{Binding Password}" TextColor="DeepSkyBlue" FontSize="Medium"/>
                                <Button Grid.Column="2" Text="Show Details" TextColor="DarkOrange" FontSize="Medium"
                                    Command="{Binding x:DataType='vm:UserListvm', Source={RelativeSource AncestorType={x:Type vm:UserListvm}},Path=ShowUserCommand}"
                                    CommandParameter="{Binding .}">
                                </Button>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </VerticalStackLayout>
</ContentPage>